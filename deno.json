{
  "imports": {
    "fresh": "jsr:@fresh/core@2.3.0",
    "preact": "npm:preact@10.29.8",
    "preact/jsx-runtime": "npm:preact@10.29.8/jsx-runtime",
    "@std/http/file-server": "jsr:@std/http@1.0.21/file-server",
    "esbuild": "npm:esbuild@0.25.12",
    "three": "npm:three@0.180.0",
    "three/addons/": "npm:three@0.180.0/examples/jsm/"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable"
    ]
  },
  "tasks": {
    "dev": "deno run -A --watch=main.tsx,projects.ts,routes,scripts,eldora-house/src,eldora-house/model.ts,eldora-house/static,duct/page.html,duct/src,shopee/components,shopee/data,shopee/static scripts/dev.ts",
    "build": "deno run -A scripts/build.ts",
    "preview": "deno run -A scripts/preview.ts",
    "publish:files": "deno run -A scripts/publish.ts",
    "check": "deno fmt --check && deno lint && deno check main.tsx scripts/build.ts scripts/dev.ts scripts/preview.ts scripts/publish.ts scripts/site_test.ts && deno test -A && deno task build && deno run --allow-read scripts/verify.ts",
    "test:links": "deno run --allow-read scripts/links.ts"
  },
  "fmt": {
    "exclude": [
      "node_modules/",
      "dist/",
      "index.html",
      "duct/index.html",
      "duct/page.html",
      "duct/src/",
      "duct/dist/",
      "duct/viewer.js",
      "duct/styles.css",
      "shopee/index.html",
      "shopee/styles.css",
      "shopee/interactions.js",
      "shopee/sw.js",
      "shopee/static/",
      "shopee/manifest.webmanifest",
      "shopee/docs/HISTORY.md",
      "eldora-house/index.html",
      "eldora-house/viewer.js",
      "eldora-house/styles.css",
      ".published-files.json",
      "backyard-garden/index.html"
    ]
  },
  "lint": {
    "exclude": [
      "node_modules/",
      "dist/",
      "duct/src/",
      "duct/dist/",
      "duct/viewer.js",
      "shopee/static/",
      "shopee/interactions.js",
      "shopee/sw.js",
      "eldora-house/viewer.js"
    ]
  }
}
